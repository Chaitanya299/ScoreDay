datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Task {
  id             String           @id @default(cuid())
  title          String
  description    String?
  category       String?
  points         Int              @default(10)
  // Recurrence model: NONE | DAILY | WEEKLY | CUSTOM | WEEKLY_GOAL
  recurrenceType String           @default("NONE")
  // For DAILY/WEEKLY/CUSTOM: interval (default: 1)
  interval       Int              @default(1)
  // For CUSTOM: unit (DAY | WEEK | MONTH)
  unit           String?          // DAY, WEEK, MONTH
  // For WEEKLY/WEEKLY_GOAL/CUSTOM with WEEK unit: selected weekdays (CSV, 0=Sun..6=Sat)
  selectedWeekdays String?       // "0,1,2,3,4,5,6"
  // For CUSTOM with MONTH unit: day of month (1-31)
  dayOfMonth     Int?             // 1-31
  // For NONE (one-time tasks): due date
  dueDate        String?          // YYYY-MM-DD
  // For all types: start date (when recurrence begins)
  startDate      String?          // YYYY-MM-DD
  // For all types: optional end date (when recurrence ends)
  endDate        String?          // YYYY-MM-DD
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  completions    TaskCompletion[]

  @@index([recurrenceType])
}

model TaskCompletion {
  id             String   @id @default(cuid())
  taskId         String
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completedAt    DateTime @default(now())
  occurrenceDate String
  completedOn    String
  pointsEarned   Int

  @@unique([taskId, occurrenceDate])
  @@index([completedOn])
}